# Resend — used by the contact form server action and admin email tab.
# Get your API key from https://resend.com/api-keys
# Copy this file to `.env.local` (recommended) or `.env`, then restart the dev server.
RESEND_API_KEY=

# Where contact form submissions are delivered.
CONTACT_EMAIL_TO=saif@lineamode.com

# Verified sending domain in Resend. For first tests use onboarding@resend.dev
# (sandbox: only delivers to the email on your Resend account).
CONTACT_EMAIL_FROM=Lineamode <hello@lineamode.com>

# Set false/0/off/no to skip the submitter auto-reply (admin notification still sends).
CONTACT_AUTO_REPLY=true

# Default From: address used by /admin email tab and intake auto-replies.
RESEND_FROM=Lineamode <hello@lineamode.com>

# Salt mixed into hashed IPs stored on intake_events. Any random string.
IP_HASH_SALT=

# Supabase credentials (for intake + admin backend).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public browser keys for client-side admin login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
