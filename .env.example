# Resend — used by the contact form server action and admin email tab.
# Get your API key from https://resend.com/api-keys
# Copy this file to `.env.local` (recommended) or `.env`, then restart the dev server.
RESEND_API_KEY=

# Where contact form submissions are delivered. Also used as the Reply-To on
# every outbound message.
CONTACT_EMAIL_TO=saif@lineamode.com

# From: address for the contact form. MUST be on a domain verified in Resend
# — lineamode-apparel.com is the verified one. `onboarding@resend.dev` is
# Resend's shared sandbox sender: it only ever delivers to the address on your
# own Resend account, so leaving it set means nobody else receives anything.
CONTACT_EMAIL_FROM=Lineamode <studio@lineamode-apparel.com>

# Set false/0/off/no to skip the submitter auto-reply (admin notification still sends).
CONTACT_AUTO_REPLY=true

# Default From: address used by the /admin email tab and intake auto-replies.
# Same verified-domain rule applies.
RESEND_FROM=Lineamode <studio@lineamode-apparel.com>

# Salt mixed into hashed IPs stored on intake_events. Any random string.
IP_HASH_SALT=

# Supabase credentials (for intake + admin backend).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public browser keys for client-side admin login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
