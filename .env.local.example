# Copy to `.env.local` (recommended) or `.env` — Next.js loads both in dev.
# Restart the dev server after changing any value here.
#
# Resend — contact form + intake auto-replies
# https://resend.com/api-keys
RESEND_API_KEY=

# For first tests use Resend's sandbox sender (only delivers to your Resend account email):
# CONTACT_EMAIL_FROM=onboarding@resend.dev
CONTACT_EMAIL_TO=saif@lineamode.com
CONTACT_EMAIL_FROM=Lineamode <hello@lineamode.com>
CONTACT_AUTO_REPLY=true

# Default From: for /admin email tab and intake auto-replies
RESEND_FROM=Lineamode <hello@lineamode.com>

# Salt mixed into hashed IPs stored on intake_events
IP_HASH_SALT=

# Supabase (optional for contact form email; required for admin inbox persist)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
